<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.shape.SVGPath?>
<StackPane xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" visible="false" managed="false" fx:controller="resolveit.frontend.ui.TechnicianTicketDetailController">
  <VBox spacing="16.0">
    <HBox alignment="CENTER_LEFT" spacing="12.0">
      <Button mnemonicParsing="true" onAction="#showQueue" text="←  _Back" styleClass="secondary-button, compact-button"/>
      <VBox spacing="3.0">
        <HBox alignment="CENTER_LEFT" spacing="10.0">
          <Label fx:id="detailNumberLabel" text="Ticket details" styleClass="workspace-heading"/>
          <Label fx:id="detailStatusLabel" styleClass="status-pill"/>
        </HBox>
        <Label text="Review request details, take support actions, and follow the conversation." styleClass="workspace-description" wrapText="true"/>
      </VBox>
      <Region HBox.hgrow="ALWAYS"/>
      <ProgressIndicator fx:id="detailProgress" maxHeight="23.0" maxWidth="23.0" accessibleText="Ticket details are loading" visible="false" managed="false"/>
      <Label fx:id="detailBusyLabel" text="Loading ticket…" styleClass="busy-label" visible="false" managed="false"/>
      <Button fx:id="refreshDetailButton" mnemonicParsing="true" onAction="#refreshDetails" text="↻  _Refresh" styleClass="secondary-button, compact-button"/>
    </HBox>
    <Label fx:id="detailErrorLabel" wrapText="true" styleClass="form-error"/>
    <HBox fx:id="detailNoticeBox" alignment="CENTER_LEFT" spacing="10.0" styleClass="success-message">
      <StackPane fx:id="detailNoticeMark" minHeight="24.0" minWidth="24.0" prefHeight="24.0" prefWidth="24.0" styleClass="completion-mark">
        <SVGPath content="M 5.2 10.9 L 2.3 8.0 L 1 9.3 L 5.2 13.5 L 14 4.7 L 12.7 3.4 Z" styleClass="completion-mark-path"/>
      </StackPane>
      <Label fx:id="detailNoticeLabel" maxWidth="Infinity" wrapText="true" HBox.hgrow="ALWAYS"/>
    </HBox>
    <ScrollPane fitToWidth="true" hbarPolicy="NEVER" VBox.vgrow="ALWAYS" styleClass="transparent-scroll">
      <VBox fx:id="detailContent" spacing="18.0" visible="false" managed="false">
        <VBox spacing="18.0" styleClass="content-card">
          <HBox alignment="CENTER_LEFT" spacing="8.0">
            <Label text="Request" styleClass="card-heading"/>
            <Region HBox.hgrow="ALWAYS"/>
            <Button fx:id="takeButton" mnemonicParsing="true" onAction="#takeTicket" text="_Take ticket" styleClass="primary-button, compact-button"/>
            <Button fx:id="beginWorkButton" mnemonicParsing="true" onAction="#beginWork" text="_Begin work" styleClass="primary-button, compact-button"/>
            <Button fx:id="cancelButton" mnemonicParsing="true" text="_Cancel ticket" onAction="#cancelTicket" styleClass="danger-button, compact-button" visible="false" managed="false"/>
            <Button fx:id="reopenButton" mnemonicParsing="true" onAction="#reopenTicket" text="_Reopen" styleClass="primary-button, compact-button"/>
          </HBox>
          <VBox spacing="5.0">
            <Label text="SUBJECT" styleClass="detail-key"/>
            <Label fx:id="detailSubjectLabel" wrapText="true" styleClass="detail-title"/>
          </VBox>
          <VBox spacing="5.0">
            <Label text="DESCRIPTION" styleClass="detail-key"/>
            <Label fx:id="detailDescriptionLabel" wrapText="true" styleClass="detail-value"/>
          </VBox>
          <Separator/>
          <FlowPane fx:id="detailMetadata" hgap="30.0" vgap="14.0">
            <VBox minWidth="160.0" spacing="4.0">
              <Label text="CATEGORY" styleClass="detail-key"/>
              <Label fx:id="detailCategoryLabel" wrapText="true" styleClass="detail-value"/>
            </VBox>
            <VBox minWidth="160.0" spacing="4.0">
              <Label text="PRIORITY" styleClass="detail-key"/>
              <Label fx:id="detailPriorityLabel" wrapText="true" styleClass="detail-value"/>
            </VBox>
            <VBox minWidth="160.0" spacing="4.0">
              <Label text="CREATED" styleClass="detail-key"/>
              <Label fx:id="detailCreatedLabel" wrapText="true" styleClass="detail-value"/>
            </VBox>
            <VBox minWidth="160.0" spacing="4.0">
              <Label text="REQUESTER" styleClass="detail-key"/>
              <Label fx:id="detailRequesterLabel" wrapText="true" styleClass="detail-value"/>
            </VBox>
            <VBox minWidth="160.0" spacing="4.0">
              <Label text="ASSIGNEE" styleClass="detail-key"/>
              <Label fx:id="detailAssigneeLabel" wrapText="true" styleClass="detail-value"/>
            </VBox>
          </FlowPane>
          <VBox fx:id="resolutionBox" spacing="5.0" visible="false" managed="false" styleClass="resolution-box">
            <Label text="RESOLUTION" styleClass="detail-key"/>
            <Label fx:id="resolutionLabel" wrapText="true" styleClass="detail-value"/>
          </VBox>
        </VBox>
        <VBox spacing="12.0" styleClass="content-card">
          <VBox fx:id="assignmentBox" spacing="8.0">
            <Label fx:id="assigneeFieldLabel" text="Assign or reassign" styleClass="field-label"/>
            <ComboBox fx:id="assigneeField" maxWidth="Infinity"/>
            <HBox spacing="10.0">
              <Button fx:id="assignButton" mnemonicParsing="true" text="_Assign" onAction="#assignTicket" styleClass="primary-button, compact-button"/>
              <Button fx:id="refreshAssigneesButton" mnemonicParsing="true" text="_Refresh assignable users" onAction="#refreshAssignees" styleClass="secondary-button, compact-button"/>
            </HBox>
          </VBox>
          <Label text="Support actions" styleClass="card-heading"/>
          <VBox fx:id="resolveBox" spacing="8.0" visible="false" managed="false" styleClass="resolution-action-box">
            <Label fx:id="resolutionFieldLabel" text="Resolution note" styleClass="field-label"/>
            <TextArea fx:id="resolutionField" prefHeight="100.0" wrapText="true" promptText="Describe what fixed the issue…" accessibleHelp="A non-blank resolution note is required."/>
            <Label fx:id="resolutionErrorLabel" wrapText="true" styleClass="field-error"/>
            <HBox alignment="CENTER_RIGHT">
              <Button fx:id="resolveButton" mnemonicParsing="true" onAction="#resolveTicket" text="_Resolve ticket" styleClass="primary-button, workspace-button"/>
            </HBox>
          </VBox>
          <HBox alignment="CENTER_LEFT" spacing="10.0">
            <Label fx:id="priorityFieldLabel" text="Priority" styleClass="field-label"/>
            <ComboBox fx:id="priorityField" prefWidth="150.0"/>
            <Button fx:id="changePriorityButton" mnemonicParsing="true" onAction="#changePriority" text="_Update priority" styleClass="secondary-button, compact-button"/>
          </HBox>
        </VBox>
        <VBox spacing="14.0" styleClass="content-card">
          <Label text="Conversation and internal notes" styleClass="card-heading"/>
          <Label text="Internal notes are visible only to technicians and managers." styleClass="hint-label"/>
          <ListView fx:id="messagesList" prefHeight="270.0" accessibleText="Ticket messages and internal notes">
            <placeholder>
              <Label text="No public comments or internal notes yet." styleClass="empty-label"/>
            </placeholder>
          </ListView>
          <VBox spacing="7.0">
            <HBox alignment="CENTER_LEFT" spacing="10.0">
              <Label fx:id="messageTypeFieldLabel" text="Post as" styleClass="field-label"/>
              <ComboBox fx:id="messageTypeField" prefWidth="175.0"/>
            </HBox>
            <Label fx:id="messageFieldLabel" text="Message" styleClass="field-label"/>
            <TextArea fx:id="messageField" prefHeight="100.0" wrapText="true"/>
            <Label fx:id="messageErrorLabel" wrapText="true" styleClass="field-error"/>
            <HBox alignment="CENTER_RIGHT">
              <Button fx:id="addMessageButton" mnemonicParsing="true" onAction="#addMessage" text="_Post message" styleClass="primary-button, workspace-button"/>
            </HBox>
          </VBox>
        </VBox>
      </VBox>
    </ScrollPane>
  </VBox>
</StackPane>
