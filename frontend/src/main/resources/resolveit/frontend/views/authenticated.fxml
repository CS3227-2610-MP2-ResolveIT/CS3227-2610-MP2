<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<BorderPane minHeight="620.0" minWidth="900.0" prefHeight="720.0" prefWidth="1120.0"
            styleClass="shell-background" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="resolveit.frontend.ui.AuthenticatedController">
    <top>
        <HBox alignment="CENTER_LEFT" spacing="12.0" styleClass="shell-header">
            <padding><Insets bottom="18.0" left="34.0" right="34.0" top="18.0" /></padding>
            <StackPane minHeight="38.0" minWidth="38.0" prefHeight="38.0" prefWidth="38.0" styleClass="shell-logo">
                <Label text="R" styleClass="shell-logo-text" />
            </StackPane>
            <Label text="ResolveIT" styleClass="shell-brand-name" />
            <Region HBox.hgrow="ALWAYS" />
            <Button accessibleText="Sign out of ResolveIT" mnemonicParsing="true" onAction="#logout"
                    text="Sign _out" styleClass="secondary-button" />
        </HBox>
    </top>
    <center>
        <StackPane>
            <padding><Insets bottom="56.0" left="56.0" right="56.0" top="56.0" /></padding>
            <VBox alignment="CENTER" maxWidth="600.0" spacing="22.0" styleClass="welcome-card">
                <padding><Insets bottom="52.0" left="56.0" right="56.0" top="52.0" /></padding>
                <Label text="Signed in successfully" styleClass="eyebrow" />
                <StackPane minHeight="86.0" minWidth="86.0" prefHeight="86.0" prefWidth="86.0"
                           styleClass="avatar">
                    <Label fx:id="avatarLabel" styleClass="avatar-text" />
                </StackPane>
                <VBox alignment="CENTER" spacing="7.0">
                    <Label fx:id="welcomeLabel" styleClass="welcome-heading" />
                    <Label fx:id="emailLabel" styleClass="welcome-email" />
                    <Label fx:id="roleLabel" styleClass="role-pill" />
                </VBox>
                <Label alignment="CENTER" text="Your workspace is ready. Ticket navigation will be added in the next frontend increment."
                       textAlignment="CENTER" wrapText="true" styleClass="welcome-description" />
            </VBox>
        </StackPane>
    </center>
</BorderPane>
