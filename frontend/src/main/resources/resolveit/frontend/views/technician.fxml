<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<BorderPane xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" minHeight="620.0" minWidth="900.0" prefHeight="760.0" prefWidth="1200.0" styleClass="shell-background, technician-workspace" fx:controller="resolveit.frontend.ui.TechnicianController">
  <top>
    <HBox alignment="CENTER_LEFT" spacing="12.0" styleClass="shell-header">
      <padding>
        <Insets bottom="16.0" left="24.0" right="24.0" top="16.0"/>
      </padding>
      <StackPane minHeight="38.0" minWidth="38.0" prefHeight="38.0" prefWidth="38.0" styleClass="shell-logo">
        <Label text="R" styleClass="shell-logo-text"/>
      </StackPane>
      <Label text="ResolveIT" styleClass="shell-brand-name"/>
      <Label fx:id="workspaceLabel" text="Technician workspace" styleClass="portal-label, technician-portal-label"/>
      <Region HBox.hgrow="ALWAYS"/>
      <VBox alignment="CENTER_RIGHT" spacing="1.0">
        <Label fx:id="userNameLabel" styleClass="user-name"/>
        <Label fx:id="userRoleLabel" styleClass="user-role"/>
      </VBox>
      <StackPane minHeight="38.0" minWidth="38.0" prefHeight="38.0" prefWidth="38.0" styleClass="header-avatar">
        <Label fx:id="avatarLabel" styleClass="header-avatar-text"/>
      </StackPane>
      <Button fx:id="logoutButton" accessibleText="Sign out of ResolveIT" mnemonicParsing="true" onAction="#logout" text="Sign _out" styleClass="secondary-button"/>
    </HBox>
  </top>
  <left>
    <VBox minWidth="218.0" prefWidth="218.0" spacing="8.0" styleClass="sidebar">
      <padding>
        <Insets bottom="24.0" left="16.0" right="16.0" top="28.0"/>
      </padding>
      <Label text="SUPPORT" styleClass="nav-section-label"/>
      <Button fx:id="queueNavButton" accessibleText="Open Ticket Queue" maxWidth="Infinity" mnemonicParsing="true" onAction="#showQueue" text="▤  Ticket _Queue" styleClass="nav-button"/>
      <Button fx:id="requestsNavButton" accessibleText="Open request workspace" maxWidth="Infinity" mnemonicParsing="true" onAction="#showRequests" text="_Request workspace" styleClass="nav-button"/>
      <Button fx:id="usersNavButton" text="_User Management" onAction="#showUsers" mnemonicParsing="true" styleClass="nav-button" maxWidth="Infinity"/>
      <Region VBox.vgrow="ALWAYS"/>
    </VBox>
  </left>
  <center>
    <StackPane>
      <padding>
        <Insets bottom="30.0" left="34.0" right="34.0" top="30.0"/>
      </padding>
      <fx:include fx:id="queuePage" source="technician-queue.fxml"/>
      <fx:include fx:id="detailPage" source="technician-ticket-detail.fxml"/>
    </StackPane>
  </center>
</BorderPane>
