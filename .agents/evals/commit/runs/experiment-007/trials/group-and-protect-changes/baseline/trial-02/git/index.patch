diff --git a/scripts/check-source.sh b/scripts/check-source.sh
new file mode 100755
index 0000000..31596de
--- /dev/null
+++ b/scripts/check-source.sh
@@ -0,0 +1,7 @@
+#!/usr/bin/env bash
+set -euo pipefail
+
+if grep -R $'\t' src --include='*.java'; then
+  echo "Java sources contain tab characters" >&2
+  exit 1
+fi
diff --git a/src/resolveit/ticket/TicketSummary.java b/src/resolveit/ticket/TicketSummary.java
new file mode 100644
index 0000000..44201c8
--- /dev/null
+++ b/src/resolveit/ticket/TicketSummary.java
@@ -0,0 +1,9 @@
+package resolveit.ticket;
+
+public final class TicketSummary {
+    private TicketSummary() {}
+
+    public static String format(String subject, String priority) {
+        return "[" + priority + "] " + subject;
+    }
+}
